<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#FFFDF9">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/dream_dictionary_icon"
        android:contentDescription="Ibn Seerin Dream Dictionary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Ibn Seerin's\nDictionary of Dreams"
        android:textColor="#4E342E"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="A searchable reference based on the classical dream dictionary."
        android:textColor="#6D625D"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/landingSearchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Enter a dream symbol, such as money"
        android:singleLine="true"
        android:inputType="text"
        android:padding="14dp"
        android:textSize="16sp"
        android:backgroundTint="#8D6E63" />

    <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:text="SEARCH THE DICTIONARY"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Developed by Iqsoft"
        android:textColor="#5D4037"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Contact +91 9037262144 for more apps like this"
        android:textColor="#6D625D"
        android:textSize="13sp" />

</LinearLayout>
